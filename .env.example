# ---------------------------------------------------------------------------
# NOVA — environment configuration template
# Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# openai | ollama | mock
AI_PROVIDER=openai

# OpenAI-compatible endpoint (works with any /v1 compatible server)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# --- Voice -----------------------------------------------------------------
# STT: faster-whisper | mock
STT_PROVIDER=faster-whisper
# tiny | base | small | medium | large-v3
STT_MODEL=base

# TTS: pyttsx3 | kokoro | piper | none
TTS_PROVIDER=pyttsx3
TTS_MODEL=

# --- Storage / logging ------------------------------------------------------
DATABASE_URL=
LOG_LEVEL=INFO

# --- Desktop ----------------------------------------------------------------
# NOVA_QT_OFFSCREEN=1  # headless UI smoke test (CI only)
